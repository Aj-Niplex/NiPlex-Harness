# NiPlex Harness — only bot token required to start.
# Provider / key / model are configured in chat with /setup

GATEWAY=discord
REQUIRE_ALLOWLIST=true

DISCORD_BOT_TOKEN=
ALLOWED_DISCORD_IDS=

TELEGRAM_BOT_TOKEN=
ALLOWED_TELEGRAM_IDS=

# Optional fallbacks if you prefer env instead of /setup
PROVIDER=agnes
AGNES_API_KEY=
AGNES_BASE_URL=https://apihub.agnes-ai.com/v1
AGNES_MODEL=agnes-2.0-flash
GOOGLE_API_KEY=
GOOGLE_MODEL=gemini-2.0-flash
OPENAI_API_KEY=
OPENAI_BASE_URL=https://api.openai.com/v1
OPENAI_MODEL=gpt-4o-mini

MEMORY_ROOT=./data
DATA_DIR=./data

SANDBOX_MODE=builtin
SANDBOX_TIMEOUT=60
SANDBOX_MAX_MEMORY_MB=512

# Opt-in only
ENABLE_GITHUB_ISSUES=false
GITHUB_PAT=
GITHUB_ISSUES_REPO=Aj-Niplex/NiPlex-Harness

# Push notifications (optional)
NTFY_TOPIC=
NTFY_URL=https://ntfy.sh

# MCP connector config can live in mcp/.env — see mcp/.env.example if present

LOG_LEVEL=INFO
